# Copie para .env em ambiente local.
# Nunca versionar segredos reais.

APP_ENV=local
APP_NAME=PSFINANCE
PORT=5001
VPS_HOST=vps69143.publiccloud.com.br
VPS_IP=191.252.93.136
GIT_BRANCH=local
GIT_COMMIT=local
PSFINANCE_STAGING_BASE_PATH=/staging/psfinance
PSFINANCE_STAGING_HEALTH_URL=http://127.0.0.1:5104/health
PSFINANCE_INSTANCE_PATH=instance
# Staging deve usar PostgreSQL. Nao versionar usuario, senha ou host reais.
PSFINANCE_STAGING_DATABASE_URL=postgresql+psycopg2://psfinance_staging_app:trocar@127.0.0.1:5432/psfinance_staging
# Uso local legado, somente quando PostgreSQL nao estiver configurado.
PSFINANCE_DATABASE_URL=sqlite:///instance/financeiro.db
PSFINANCE_UPLOAD_TITULOS_FOLDER=instance/uploads/titulos
# Configure um valor real no ambiente. Nao versionar segredos.
PSFINANCE_SECRET_KEY=trocar-em-staging
# Limites defensivos do PostgreSQL para evitar ocupação prolongada dos workers.
PSFINANCE_DB_CONNECT_TIMEOUT=5
PSFINANCE_DB_STATEMENT_TIMEOUT_MS=10000
PSFINANCE_DB_LOCK_TIMEOUT_MS=3000
PSFINANCE_DB_POOL_RECYCLE_SECONDS=300
PSFINANCE_DB_POOL_TIMEOUT_SECONDS=5
